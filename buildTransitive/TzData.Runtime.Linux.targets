<Project>

  <PropertyGroup>
    <TzDataRuntimeCopyData Condition="'$(TzDataRuntimeCopyData)' == ''">true</TzDataRuntimeCopyData>
    <_TzDataRuntimeDataDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..', 'tzdata'))</_TzDataRuntimeDataDir>
  </PropertyGroup>

  <!-- Linux-only: copy the packaged tzdata next to the app (and into the publish root).
       This covers explicit Linux RIDs (including cross-publishing from Windows/macOS) and
       portable builds made on a Linux host. Non-Linux builds do not get the data. -->
  <ItemGroup Condition="'$(TzDataRuntimeCopyData)' != 'false' and ($([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))))">
    <None Include="$(_TzDataRuntimeDataDir)**/*"
          Link="tzdata/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
