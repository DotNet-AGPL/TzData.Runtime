<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TzDataRuntimeAutoInitTimeZone>Asia/Shanghai</TzDataRuntimeAutoInitTimeZone>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TzData.Runtime.Linux.AutoInit" Version="$(TzDataPackageVersion)" />
    <!-- App-local ICU for Chiseled/Distroless (no system libicu). CI passes -p:UseAppLocalIcu=true
         together with the target RID, so only the matching platform package is restored. -->
    <PackageReference Include="Icu4C.Runtime.linux-x64" Version="79.1.1" Condition="'$(UseAppLocalIcu)' == 'true' and '$(RuntimeIdentifier)' == 'linux-x64'" />
    <PackageReference Include="Icu4C.Runtime.linux-musl-x64" Version="79.1.1" Condition="'$(UseAppLocalIcu)' == 'true' and '$(RuntimeIdentifier)' == 'linux-musl-x64'" />

  </ItemGroup>

</Project>
