<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TzData.Runtime" Version="$(TzDataPackageVersion)" />
    <!-- App-local ICU for Chiseled/Distroless (no system libicu). CI passes -p:UseAppLocalIcu=true
         together with the target RID, so only the matching platform package is restored. -->
    <PackageReference Include="Icu4C.Runtime.linux-x64" Version="79.1.1" Condition="'$(UseAppLocalIcu)' == 'true' and '$(RuntimeIdentifier)' == 'linux-x64'" />
    <PackageReference Include="Icu4C.Runtime.osx-arm64" Version="79.1.1" Condition="'$(UseAppLocalIcu)' == 'true' and '$(RuntimeIdentifier)' == 'osx-arm64'" />
  </ItemGroup>

</Project>
